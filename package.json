{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n": "to18ml",
    "i18n:check": "to18ml --check",
    "predev": "to18ml",
    "prebuild": "to18ml",
    "dev": "vite --port 3001 --host 0.0.0.0",
    "dev:bun": "bun --hot src/index.ts",
    "build": "vite build --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "optimize:images": "node scripts/optimize-images.mjs --write",
    "start": "NODE_ENV=production bun src/index.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@mcbalaam/razdor-ui": "^0.3.0",
    "@mcbalaam/to18ml": "^0.1.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@react-spring/web": "^10.0.3",
    "@supabase/supabase-js": "^2.93.3",
    "framer-motion": "^12.34.3",
    "lucide-react": "^1.56.0",
    "ogl": "^1.0.11",
    "react": "^19",
    "react-content-loader": "^7.1.2",
    "react-countup": "^6.5.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "gh-pages": "^6.3.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  },
  "homepage": "https://mcbalaam.github.io"
}

{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n": "to18ml",
    "i18n:check": "to18ml --check",
    "predev": "to18ml",
    "prebuild": "to18ml",
    "dev": "vite --port 3001 --host 0.0.0.0",
    "dev:bun": "bun --hot src/index.ts",
    "build": "vite build --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "optimize:images": "node scripts/optimize-images.mjs --write",
    "start": "NODE_ENV=production bun src/index.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@mcbalaam/razdor-ui": "^0.3.0",
    "@mcbalaam/to18ml": "^0.1.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@supabase/auth-js": "^2.119.0",
    "@supabase/postgrest-js": "^2.119.0",
    "lucide-react": "^1.56.0",
    "ogl": "^1.0.11",
    "preact": "^11.1.1",
    "preact-compat": "^3.19.0",
    "preact-dom": "^1.0.1",
    "react-content-loader": "^7.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "gh-pages": "^6.3.0",
    "rollup-plugin-visualizer": "^7.1.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  },
  "homepage": "https://mcbalaam.github.io"
}
